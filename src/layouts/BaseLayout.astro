---
import '@fontsource-variable/inter/opsz.css';
import '@/styles/global.css';
import interUrl from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { cleanPath } from '@/utils/path';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  header?: 'overlay' | 'solid';
  /** Breadcrumb trail (excluding Home) for structured data. */
  crumbs?: { label: string; href: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description, image, header = 'solid', crumbs = [], jsonLd, noindex = false } = Astro.props;

const path = cleanPath(Astro.url.pathname);
const isHome = path === '/';
const fullTitle = isHome ? title : `${title} · ${site.name}, ${site.city}`;
const canonical = new URL(path, Astro.site);
const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, format: 'jpg', quality: 78 })).src, Astro.site)
  : new URL('/og-default.jpg', Astro.site);

const school = {
  '@context': 'https://schema.org',
  '@type': 'School',
  '@id': `${site.url}/#school`,
  name: site.name,
  alternateName: site.shortName,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  image: `${site.url}/og-default.jpg`,
  email: site.email,
  telephone: site.phones.map((p) => p.href.replace('tel:', '')),
  slogan: site.motto.join(' · '),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  parentOrganization: { '@type': 'Organization', name: site.society },
  sameAs: [site.officialUrl, ...site.socials.map((s) => s.href)],
};

const breadcrumbs = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        item: new URL(c.href, Astro.site).toString(),
      })),
    }
  : null;

const structured = [isHome ? school : null, breadcrumbs, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(Boolean);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0a1c38" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name}, ${site.city}`} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script is:inline defer src="/analytics.js"></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header variant={header} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '@/scripts/reveal';
    </script>
  </body>
</html>

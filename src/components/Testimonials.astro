---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { testimonials } from '@/data/site';

const initials = (name: string) =>
  name
    .replace(/^(Mrs?\.|Ms\.)\s*/, '')
    .split(' ')
    .map((p) => p[0])
    .slice(0, 2)
    .join('');
---

<section class="section section--white testimonials" aria-labelledby="voices-title">
  <div class="container">
    <SectionHead eyebrow="Parent voices" title="Trusted by the families <em>who know us best</em>" align="split" id="voices-title">
      <div class="testimonials__controls" role="group" aria-label="Testimonial controls">
        <button type="button" class="round-btn" data-prev aria-label="Previous testimonial"><Icon name="arrow-left" size={20} /></button>
        <button type="button" class="round-btn" data-next aria-label="Next testimonial"><Icon name="arrow-right" size={20} /></button>
      </div>
    </SectionHead>

    <ul class="testimonials__track" role="list" data-track tabindex="0" aria-label="Parent testimonials">
      {
        testimonials.map((t, i) => (
          <li class="quote-card" data-reveal style={`--d: ${i * 90}`}>
            <Icon name="quote" size={34} class="quote-card__mark" />
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <div class="quote-card__by">
              <span class="quote-card__avatar" aria-hidden="true">
                {initials(t.name)}
              </span>
              <div>
                <p class="quote-card__name">{t.name}</p>
                <p class="quote-card__rel">
                  {t.relation} · {t.grade}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials__controls {
    display: flex;
    gap: 0.6rem;
    justify-self: end;
  }

  .round-btn {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    border: 1.5px solid var(--line-2);
    color: var(--ink);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .round-btn:hover {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--white);
  }

  .testimonials__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(88%, 30rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    padding: 0.25rem 0 1.5rem;
    margin: 0;
    list-style: none;
    scrollbar-width: none;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 1080px) {
    .testimonials__track {
      grid-auto-columns: calc((100% - 2 * 1.25rem) / 3);
    }
  }

  .quote-card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.6rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .quote-card :global(.quote-card__mark) {
    color: var(--gold-500);
    fill: var(--gold-100);
  }

  .quote-card blockquote {
    flex: 1;
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--ink);
    font-weight: 450;
  }

  .quote-card__by {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .quote-card__avatar {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    background: var(--navy-900);
    color: var(--gold-400);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    flex: none;
  }

  .quote-card__name {
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .quote-card__rel {
    font-size: 0.86rem;
    color: var(--ink-3);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.testimonials').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const step = () => {
      const card = track.querySelector<HTMLElement>('li');
      return card ? card.getBoundingClientRect().width + 20 : track.clientWidth * 0.8;
    };
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const go = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth - 4;
      let left = track.scrollLeft + dir * step();
      if (dir > 0 && track.scrollLeft >= max) left = 0;
      if (dir < 0 && track.scrollLeft <= 4) left = max;
      track.scrollTo({ left, behavior: reduced ? 'auto' : 'smooth' });
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(1));
  });
</script>

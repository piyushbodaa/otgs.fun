---
interface Props {
  eyebrow: string;
  /** May contain <em> for the italic accent. */
  title: string;
  lead?: string;
  align?: 'start' | 'center' | 'split';
  level?: 'h2' | 'h3';
  id?: string;
}

const { eyebrow, title, lead, align = 'start', level = 'h2', id } = Astro.props;
const Heading = level;
---

<div class:list={['section-head', { 'section-head--center': align === 'center', 'section-head--split': align === 'split' }]} data-reveal>
  <div class="stack" style="--stack: 1.1rem">
    <p class:list={['eyebrow', { 'eyebrow--center': align === 'center' }]}>{eyebrow}</p>
    <Heading class="t-h2" id={id} set:html={title} />
  </div>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

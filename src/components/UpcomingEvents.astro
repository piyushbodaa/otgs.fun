---
import { events } from '@/data/events';

interface Props {
  /** How many upcoming events to show; omit to show every remaining one. */
  limit?: number;
}

const { limit } = Astro.props;

// Every remaining event is rendered: the site is only rebuilt on deploy, so the
// script below picks what to show by the visitor's own date.
const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((e) => e.date >= today);
const show = limit ?? upcoming.length;
const fmtDay = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit' });
const fmtMonth = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { month: 'short' });
const fmtWeekday = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'long' });
---

{
  upcoming.length > 0 && (
    <ol class="events__list" role="list" data-events data-limit={limit}>
      {upcoming.map((e, i) => (
        <li class="event" data-date={e.date} hidden={i >= show ? true : undefined} data-reveal style={`--d: ${(i % 4) * 90}`}>
          <time datetime={e.date} class="event__date">
            <span class="event__day">{fmtDay(e.date)}</span>
            <span class="event__month">{fmtMonth(e.date)}</span>
          </time>
          <div>
            <p class="event__weekday">{fmtWeekday(e.date)}</p>
            <h3 class="event__title">{e.title}</h3>
            {e.who && <p class="event__who">{e.who}</p>}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .events__list {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .events__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .events__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .event {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
  }

  .event[hidden] {
    display: none;
  }

  .event__date {
    display: grid;
    place-items: center;
    flex: none;
    width: 4.2rem;
    padding: 0.6rem 0;
    border-radius: 14px;
    background: var(--navy-900);
    color: var(--white);
    line-height: 1;
  }

  .event__day {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .event__month {
    margin-top: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-400);
  }

  .event__weekday {
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .event__title {
    margin-top: 0.2rem;
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .event__who {
    margin-top: 0.35rem;
    font-size: 0.86rem;
    color: var(--red-600);
    font-weight: 560;
  }
</style>

<script>
  // Hide calendar events that have already happened (the page may be cached for weeks).
  document.querySelectorAll<HTMLElement>('[data-events]').forEach((list) => {
    const today = new Date();
    const iso = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
    const items = [...list.querySelectorAll<HTMLElement>('[data-date]')];
    const future = items.filter((el) => (el.dataset.date ?? '') >= iso);
    const limit = list.dataset.limit ? Number(list.dataset.limit) : future.length;
    items.forEach((el) => (el.hidden = true));
    future.slice(0, limit).forEach((el, i) => {
      el.hidden = false;
      el.style.setProperty('--d', String((i % 4) * 90));
    });
    if (future.length === 0) {
      const section = list.closest<HTMLElement>('[data-events-section]');
      if (section) section.hidden = true;
    }
  });
</script>

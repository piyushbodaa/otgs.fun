---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import parade from '@/assets/photos/campus-parade.jpg';
import { site } from '@/data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Begin your child’s <em>OTGS journey</em>',
  text = `Admissions for ${site.admissionsYear} are open from Pre-Primary to Grade 10. Visit the campus, meet our teachers and see why families across Nanded choose Oxford.`,
} = Astro.props;
---

<section class="cta-band on-dark" aria-labelledby="cta-title">
  <div class="cta-band__media" aria-hidden="true">
    <Picture src={parade} alt="" widths={[800, 1280, 1920]} sizes="100vw" formats={['avif', 'webp']} />
  </div>
  <div class="container cta-band__inner" data-reveal>
    <p class="eyebrow">Admissions {site.admissionsYear}</p>
    <h2 class="t-h2" id="cta-title" set:html={title} />
    <p class="lead">{text}</p>
    <div class="cluster cta-band__actions">
      <a href="/contact#enquire" class="btn btn--gold">Book a school tour <Icon name="arrow-right" class="arrow" /></a>
      <a href={site.phones[0].href} class="btn btn--outline-light"><Icon name="phone" /> Call {site.phones[0].label}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 11vw, 9rem);
    background: var(--navy-900);
    text-align: center;
  }

  .cta-band__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta-band__media :global(picture),
  .cta-band__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .cta-band__media :global(img) {
    object-fit: cover;
  }

  .cta-band__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgb(10 28 56 / 0.72), rgb(6 17 42 / 0.94) 75%),
      linear-gradient(0deg, rgb(6 17 42 / 0.6), transparent);
  }

  .cta-band__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 52rem;
  }

  .cta-band .lead {
    color: rgb(255 255 255 / 0.82);
    max-width: 40rem;
  }

  .cta-band .eyebrow::after {
    content: '';
    width: 1.75rem;
    height: 1.5px;
    background: currentColor;
  }

  .cta-band__actions {
    justify-content: center;
    margin-top: 0.75rem;
  }
</style>

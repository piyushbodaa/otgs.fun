---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow: string;
  /** May contain <em> for the italic accent. */
  title: string;
  intro?: string;
  crumbs?: { label: string; href: string }[];
  position?: string;
}

const { image, alt, eyebrow, title, intro, crumbs = [], position = 'center' } = Astro.props;
---

<section class="page-hero on-dark">
  <div class="page-hero__media">
    <Picture
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      formats={['avif', 'webp']}
      quality={62}
      priority
      style={`object-position: ${position}`}
    />
  </div>
  <div class="container page-hero__content">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol role="list">
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((c, i) => (
              <li>
                <Icon name="chevron-right" size={14} />
                {i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="t-h1" set:html={title} />
    {intro && <p class="lead page-hero__intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(30rem, 72vh, 44rem);
    margin-top: calc(-1 * var(--header-h));
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    background: var(--navy-900);
    isolation: isolate;
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .page-hero__media :global(picture),
  .page-hero__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .page-hero__media :global(img) {
    object-fit: cover;
    animation: hero-zoom 14s var(--ease-out) both;
  }

  .page-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(6 17 42 / 0.55) 0%, rgb(6 17 42 / 0.15) 35%, rgb(6 17 42 / 0.82) 100%),
      linear-gradient(90deg, rgb(6 17 42 / 0.55), transparent 70%);
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__media :global(img) {
      animation: none;
    }
  }

  .page-hero__content {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .page-hero h1 {
    max-width: 18ch;
  }

  .page-hero__intro {
    max-width: 40rem;
    color: rgb(255 255 255 / 0.85);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 0.75rem;
    list-style: none;
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.7);
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  .crumbs [aria-current] {
    color: var(--white);
    font-weight: 600;
  }
</style>

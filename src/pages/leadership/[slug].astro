---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { leaders, type Leader } from '@/data/leaders';
import { site } from '@/data/site';

export function getStaticPaths() {
  return leaders.map((leader) => ({ params: { slug: leader.slug }, props: { leader } }));
}

interface Props {
  leader: Leader;
}

const { leader } = Astro.props;
const others = leaders.filter((l) => l.slug !== leader.slug);
const crumbs = [
  { label: 'Leadership', href: '/leadership' },
  { label: leader.role, href: `/leadership/${leader.slug}` },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: leader.name.replace(/^(Mrs?\.|Ms\.)\s*/, '').replace(/\.$/, ''),
  jobTitle: leader.role,
  worksFor: { '@type': 'School', name: site.name, url: site.url },
  image: new URL(leader.portrait.src, Astro.site).toString(),
};
---

<BaseLayout
  title={`${leader.role}’s Message`}
  description={`${leader.name}, ${leader.role} of Oxford The Global School, Nanded: “${leader.headline}”`}
  image={leader.office}
  crumbs={crumbs}
  jsonLd={person}
>
  <article class="message">
    <div class="container message__grid">
      <div class="message__aside" data-reveal>
        <nav aria-label="Breadcrumb" class="message__crumbs">
          <a href="/leadership"><Icon name="arrow-left" size={16} /> All leadership messages</a>
        </nav>
        <div class="media message__portrait">
          <Image src={leader.portrait} alt={`Portrait of ${leader.name}`} widths={[360, 540, 720]} sizes="(min-width: 960px) 28vw, 80vw" priority />
        </div>
        <p class="message__role">{leader.role}</p>
        <p class="message__name">{leader.name}</p>
        {
          leader.honour && (
            <p class="message__honour">
              <Icon name="award" size={18} />
              {leader.honour}
            </p>
          )
        }
      </div>

      <div class="message__body">
        <p class="eyebrow">{leader.role}’s message</p>
        <h1 class="message__headline">“{leader.headline}”</h1>
        <div class="message__prose prose">
          {leader.message.map((p) => <p>{p}</p>)}
        </div>
        <footer class="message__sign">
          <span class="message__sign-rule" aria-hidden="true"></span>
          <span>
            <span class="message__sign-name">{leader.name}</span>
            <span class="message__sign-role">{leader.role}, {site.name}</span>
          </span>
        </footer>
      </div>
    </div>
  </article>

  <section class="section section--paper-2" aria-labelledby="more-title">
    <div class="container">
      <h2 class="t-h3 more-title" id="more-title">More messages from our leadership</h2>
      <ul class="more" role="list">
        {
          others.map((l) => (
            <li>
              <a href={`/leadership/${l.slug}`} class="more__card">
                <Image src={l.portrait} alt="" width={120} height={120} densities={[1, 2]} class="more__img" />
                <span class="more__text">
                  <span class="more__role">{l.role}</span>
                  <span class="more__name">{l.name}</span>
                  <span class="more__quote">“{l.quote}”</span>
                </span>
                <Icon name="arrow-right" class="more__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .message {
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--section-y);
  }

  .message__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  @media (min-width: 960px) {
    .message__grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      align-items: start;
    }

    .message__aside {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .message__crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-3);
    text-decoration: none;
  }

  .message__crumbs a:hover {
    color: var(--red-600);
  }

  .message__portrait {
    aspect-ratio: 4 / 5;
    max-width: 26rem;
    box-shadow: var(--shadow-lg);
  }

  .message__role {
    margin-top: 1.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-600);
  }

  .message__name {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--ink);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .message__honour {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--gold-100);
    color: #7a5a10;
    font-size: 0.86rem;
    font-weight: 650;
  }

  .message__body {
    display: grid;
    gap: 1.6rem;
    align-content: start;
  }

  .message__headline {
    font-size: clamp(1.7rem, 1.1rem + 1.9vw, 2.55rem);
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .message__prose {
    font-size: 1.06rem;
    line-height: 1.8;
    max-width: 66ch;
  }


  .message__sign {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .message__sign-rule {
    width: 3rem;
    height: 2px;
    background: var(--gold-500);
  }

  .message__sign > span:last-child {
    display: grid;
  }

  .message__sign-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    font-weight: 650;
  }

  .message__sign-role {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  .more-title {
    margin-bottom: 2rem;
  }

  .more {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 900px) {
    .more {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .more__card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .more__card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .more__img {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .more__text {
    display: grid;
    gap: 0.2rem;
  }

  .more__role {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red-600);
  }

  .more__name {
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }

  .more__quote {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more__card :global(.more__arrow) {
    color: var(--red-600);
    transition: transform 0.3s var(--ease-out);
  }

  .more__card:hover :global(.more__arrow) {
    transform: translateX(4px);
  }
</style>

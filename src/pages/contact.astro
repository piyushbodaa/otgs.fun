---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
import hero from '@/assets/photos/campus-panorama.jpg';

const crumbs = [{ label: 'Contact', href: '/contact' }];
const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hello OTGS! I have a question.')}`;
---

<BaseLayout
  title="Contact & Book a School Tour"
  description="Visit Oxford The Global School at Puyni, Nilla Road, Nanded. Call +91 93224 13340, email oxfordtgsnnd@gmail.com, or book a school tour."
  image={hero}
  header="overlay"
  crumbs={crumbs}
>
  <PageHero
    image={hero}
    alt="A panoramic view of the Oxford The Global School campus"
    eyebrow="Reach us"
    title="We’d love to <em>hear from you</em>"
    intro="Book a school tour, ask about admissions, or simply say hello. Our team will be glad to help."
    crumbs={crumbs}
    position="50% 55%"
  />

  <section class="section section--tight" aria-labelledby="ways-title">
    <div class="container">
      <h2 class="sr-only" id="ways-title">Ways to reach us</h2>
      <ul class="ways" role="list">
        <li data-reveal>
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="way">
            <span class="icon-badge"><Icon name="map-pin" /></span>
            <span class="way__label">Visit</span>
            <span class="way__value">{site.address.line1}, {site.address.city}, {site.address.state} {site.address.postalCode}</span>
            <span class="way__cta">Get directions <Icon name="arrow-up-right" size={16} /></span>
          </a>
        </li>
        <li data-reveal style="--d: 80">
          <div class="way">
            <span class="icon-badge"><Icon name="phone" /></span>
            <span class="way__label">Call</span>
            <span class="way__value">
              {
                site.phones.map((p) => (
                  <a href={p.href} class="way__link">
                    {p.label}
                  </a>
                ))
              }
            </span>
          </div>
        </li>
        <li data-reveal style="--d: 160">
          <a href={`mailto:${site.email}`} class="way">
            <span class="icon-badge"><Icon name="mail" /></span>
            <span class="way__label">Email</span>
            <span class="way__value">{site.email}</span>
            <span class="way__cta">Write to us <Icon name="arrow-right" size={16} /></span>
          </a>
        </li>
        <li data-reveal style="--d: 240">
          <a href={whatsappHref} target="_blank" rel="noopener" class="way way--wa">
            <span class="icon-badge"><Icon name="whatsapp" /></span>
            <span class="way__label">WhatsApp</span>
            <span class="way__value">Chat with the admissions desk</span>
            <span class="way__cta">Start a chat <Icon name="arrow-up-right" size={16} /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--paper-2" id="enquire" aria-labelledby="contact-enquiry-title">
    <div class="container contact-grid">
      <div class="map-card" data-reveal="fade">
        <div class="map-card__frame">
          <iframe
            title="Map showing Oxford The Global School, Nanded"
            src={site.mapsEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
        <div class="map-card__body">
          <div>
            <p class="map-card__name">{site.name}</p>
            <p class="muted">{site.address.line1}, {site.address.city} {site.address.postalCode}</p>
          </div>
          <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn--dark btn--sm"><Icon name="navigation" /> Directions</a>
        </div>
        <div class="social-card">
          <p class="social-card__title">Follow OTGS</p>
          <ul class="cluster" role="list">
            {
              site.socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" class="chip">
                    <Icon name={s.icon} /> {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div data-reveal>
        <EnquiryForm
          id="contact-enquiry"
          title="Book a school tour"
          intro="Experience OTGS first-hand. Tell us a little about your child and we’ll arrange a visit with our admissions team."
          defaultPurpose="tour"
          headingLevel="h2"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ways {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .ways {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .ways {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ways > li {
    display: grid;
  }

  .way {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  a.way:hover {
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }

  .way .icon-badge {
    margin-bottom: 0.75rem;
  }

  .way--wa .icon-badge {
    background: #e7f7ed;
    color: #0f7f3d;
  }

  .way__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .way__value {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--ink);
    overflow-wrap: anywhere;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .way__link {
    text-decoration: none;
  }

  .way__link:hover {
    color: var(--red-600);
    text-decoration: underline;
  }

  .way__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--red-600);
  }

  .contact-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .map-card {
    border-radius: var(--radius-xl);
    background: var(--white);
    border: 1px solid var(--line);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .map-card__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--paper-3);
  }

  .map-card__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .map-card__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .map-card__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 650;
  }

  .social-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.4rem 1.6rem 1.6rem;
  }

  .social-card__title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .social-card .chip {
    text-decoration: none;
  }

  .social-card .chip:hover {
    border-color: var(--navy-900);
  }
</style>

---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { albums, photos } from '@/data/gallery';
import hero from '@/assets/gallery/annual-day/06.jpg';

const crumbs = [{ label: 'Gallery', href: '/gallery' }];

const items = await Promise.all(
  photos.map(async (p) => {
    const album = albums.find((a) => a.id === p.album)!;
    const total = photos.filter((x) => x.album === p.album).length;
    const full = await getImage({ src: p.image, width: 1600, format: 'webp', quality: 80 });
    return {
      ...p,
      albumName: album.name,
      alt: p.caption ?? `${album.alt} (photo ${p.index} of ${total})`,
      label: p.caption ?? `${album.name} · ${p.index}`,
      full: full.src,
      ratio: p.image.width / p.image.height,
    };
  }),
);
---

<BaseLayout
  title="Gallery"
  description="Photos from Oxford The Global School, Nanded: Annual Day, sports and games, labs and learning, achievements and our little learners."
  image={hero}
  header="overlay"
  crumbs={crumbs}
>
  <PageHero
    image={hero}
    alt="Students forming a gymnastic pyramid in front of the school building at night"
    eyebrow="Gallery"
    title="Moments that <em>make OTGS</em>"
    intro="Stage lights and sports days, microscopes and milestones: a glimpse of the life our students live every day."
    crumbs={crumbs}
    position="50% 45%"
  />

  <section class="section gallery-section" aria-label="Photo gallery">
    <div class="container">
      <div class="filters" role="group" aria-label="Filter photos by album" data-filters>
        <button type="button" class="filter" aria-pressed="true" data-filter="all">
          All <span>{items.length}</span>
        </button>
        {
          albums.map((a) => (
            <button type="button" class="filter" aria-pressed="false" data-filter={a.id} id={a.id}>
              {a.name} <span>{items.filter((i) => i.album === a.id).length}</span>
            </button>
          ))
        }
      </div>
      <p class="album-desc" data-album-desc aria-live="polite">A glimpse of life at OTGS across all our albums.</p>

      <ul class="justified" role="list" data-gallery>
        {
          items.map((p, i) => (
            <li class="tile" data-album={p.album} style={`--r: ${p.ratio.toFixed(4)}`}>
              <a href={p.full} class="tile__link" data-index={i} data-caption={p.label} aria-label={`Open photo: ${p.alt}`}>
                <Image src={p.image} alt={p.alt} widths={[240, 360, 540, 720]} sizes="(min-width: 1080px) 22vw, (min-width: 640px) 32vw, 42vw" loading={i < 6 ? 'eager' : 'lazy'} />
                <span class="tile__zoom" aria-hidden="true">
                  <Icon name="maximize" size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <script type="application/json" data-album-meta set:html={JSON.stringify(Object.fromEntries(albums.map((a) => [a.id, a.description])))} />
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <figure class="lightbox__figure">
      <img class="lightbox__img" alt="" data-lightbox-img />
      <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" data-lightbox-close aria-label="Close photo viewer">
      <Icon name="close" size={24} />
    </button>
    <button type="button" class="lightbox__btn lightbox__prev" data-lightbox-prev aria-label="Previous photo">
      <Icon name="chevron-left" size={28} />
    </button>
    <button type="button" class="lightbox__btn lightbox__next" data-lightbox-next aria-label="Next photo">
      <Icon name="chevron-right" size={28} />
    </button>
  </dialog>
</BaseLayout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid var(--line-2);
    background: var(--white);
    font-weight: 620;
    font-size: 0.95rem;
    color: var(--ink-2);
    scroll-margin-top: calc(var(--header-h) + 2rem);
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .filter span {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--paper-2);
    color: var(--ink-3);
  }

  .filter:hover {
    border-color: var(--navy-900);
  }

  .filter[aria-pressed='true'] {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--white);
  }

  .filter[aria-pressed='true'] span {
    background: var(--gold-400);
    color: var(--navy-950);
  }

  .album-desc {
    margin-bottom: 2rem;
    color: var(--ink-3);
  }

  /* Justified rows: each tile grows in proportion to its aspect ratio. */
  .justified {
    --row: 15rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .justified {
      --row: 9rem;
      gap: 0.5rem;
    }
  }

  .justified::after {
    content: '';
    flex-grow: 999;
  }

  .tile {
    flex-grow: calc(var(--r) * 100);
    flex-basis: calc(var(--r) * var(--row));
    aspect-ratio: var(--r);
    max-height: calc(var(--row) * 1.6);
  }

  .tile[hidden] {
    display: none;
  }

  .tile__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: var(--paper-3);
  }

  .tile__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .tile__link:hover :global(img) {
    transform: scale(1.05);
  }

  .tile__zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--navy-900);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .tile__link:hover .tile__zoom,
  .tile__link:focus-visible .tile__zoom {
    opacity: 1;
    transform: none;
  }

  /* Lightbox ------------------------------------------------------------- */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(4 10 24 / 0.96);
    color: var(--white);
  }

  .lightbox::backdrop {
    background: rgb(4 10 24 / 0.8);
  }

  /* Stop the page behind the viewer from scrolling. */
  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.25s var(--ease);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin: 0;
    padding: 4.5rem 1rem 2rem;
    max-width: 100%;
  }

  .lightbox__img {
    max-width: min(92vw, 1500px);
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
    user-select: none;
  }

  .lightbox__caption {
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.75);
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--white);
    transition: background-color 0.2s var(--ease);
  }

  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.22);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: 1rem;
  }

  .lightbox__next {
    right: 1rem;
  }

  @media (max-width: 640px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const desc = document.querySelector<HTMLElement>('[data-album-desc]');
  const meta = JSON.parse(document.querySelector('[data-album-meta]')?.textContent ?? '{}') as Record<string, string>;
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]');

  if (gallery && filters && dialog && img && caption) {
    const tiles = [...gallery.querySelectorAll<HTMLLIElement>('.tile')];
    const allText = desc?.textContent ?? '';

    const applyFilter = (id: string) => {
      filters.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
      tiles.forEach((t) => (t.hidden = id !== 'all' && t.dataset.album !== id));
      if (desc) desc.textContent = id === 'all' ? allText : (meta[id] ?? '');
    };

    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const id = btn.dataset.filter ?? 'all';
      applyFilter(id);
      history.replaceState(null, '', id === 'all' ? location.pathname : `#${id}`);
    });

    const fromHash = location.hash.slice(1);
    if (fromHash && filters.querySelector(`[data-filter="${CSS.escape(fromHash)}"]`)) applyFilter(fromHash);

    // Lightbox ----------------------------------------------------------
    let list: HTMLAnchorElement[] = [];
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + list.length) % list.length;
      const link = list[current];
      const thumb = link.querySelector('img');
      img.src = link.href;
      img.alt = thumb?.alt ?? '';
      caption.textContent = `${link.dataset.caption}  ·  ${current + 1} / ${list.length}`;
      // Warm the cache for the neighbours.
      [current + 1, current - 1].forEach((n) => {
        const l = list[(n + list.length) % list.length];
        if (l) new window.Image().src = l.href;
      });
    };

    gallery.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.tile__link');
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      list = tiles.filter((t) => !t.hidden).map((t) => t.querySelector<HTMLAnchorElement>('.tile__link')!);
      opener = link;
      show(list.indexOf(link));
      dialog.showModal();
    });

    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    });

    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>
